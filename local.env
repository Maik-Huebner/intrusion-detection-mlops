# Non-secret settings for local runs: `uv run --env-file local.env ...` (the Makefile does this).

# Opt out of anonymous usage statistics.
MLFLOW_DISABLE_TELEMETRY=true
DVC_NO_ANALYTICS=1
# Silence MLflow's console hint about its coding-assistant skills.
MLFLOW_DISABLE_AGENT_HINT=1

# macOS AirPlay occupies port 5000, so the MLflow server runs on 5050.
MLFLOW_PORT=5050

# Grafana's default port 3000 is often taken by another local service; change if needed.
GRAFANA_PORT=3001
