.idea/
.DS_Store

# Data and models are versioned by DVC, not Git:
# raw data via data/raw/*.dvc, pipeline outputs via dvc.lock (DVC adds its own .gitignore entries).

# Batch prediction output (reproducible at any time)
output/
docs/*.pptx
